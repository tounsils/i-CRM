# Copy to .env before running docker compose, which reads .env automatically.
# Nothing in this file is a real secret. Fill in your own.

# Required, at least 32 characters. It signs session cookies. Generate one with:
#   openssl rand -base64 48
#
# With ICRM_ENV=production the server refuses to start without it. Otherwise it
# generates a throwaway key at boot, which signs everybody out on every restart.
ICRM_SESSION_KEY=

# development or production.
#
# This is what decides whether session cookies are marked Secure, and a Secure
# cookie is never sent over plain HTTP. Leave it as development until the app is
# behind a TLS terminator, or nobody will be able to sign in.
ICRM_ENV=development

# Host port to publish the container on.
ICRM_PORT=8080

# Which host address to publish on. Read by docker compose, not by the binary.
#
# Loopback by default, so a default bring-up is reachable only from this
# machine. Set it to 0.0.0.0 to publish on every interface, and put a TLS
# terminator in front first: what you are exposing is a CRM whose only
# protection is a password.
ICRM_BIND=127.0.0.1

# Shown in the page title and the top bar.
ICRM_COMPANY_NAME=i-CRM

# Your own postal address, printed on documents handed to a customer. Optional;
# a document shows just the company name without it.
#
# A real newline cannot be written here, so use \n between lines.
ICRM_COMPANY_ADDRESS=

# Default currency for new customers and documents. Three-letter ISO 4217 code.
ICRM_CURRENCY=USD

# Days added to an invoice's issue date to arrive at its due date.
ICRM_PAYMENT_TERMS_DAYS=30
